HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz
HSK_TESTNET_CHAIN_ID=133
HSK_TESTNET_EXPLORER_URL=https://testnet-explorer.hsk.xyz
# Already deployed on HSK testnet from the shared account below — a teammate
# does NOT need to redeploy, just use these as-is. See docs/02-contracts-spec.md.
WHSK_ADDRESS=0x4200000000000000000000000000000000000006
HUSKY_AGENT_FACTORY_ADDRESS=0x1A962CA6a2D056008982AB04DA5494D04d5297D4
HUSKY_AGENT_ROUTER_ADDRESS=0x66eCbf42534a2309C9880F3C76cbaA51cC9a2D49
USDC_ADDRESS=0xBCf27FB0A18111e0D21b1Fb4677F9Bc6285fA75d
HUSKY_TOKEN_ADDRESS=0xc686b87dC49Ecd59Fd6d39a878F0964D152cB212
SPECULOS_TRANSPORT_URL=127.0.0.1:40000
HSK_FLASHBLOCKS_WS_URL=wss://testnet-flashblocks.hsk.xyz/ws

# Testnet-only mnemonic — see docs/05-signing-spec.md. Loaded into Speculos as
# the emulated Ledger's seed (scripts/speculos-start.sh). Safe to commit: it
# must NEVER hold real value or be used outside testnets, by design — treat
# any funds ever sent to its address as burned.
TESTNET_MNEMONIC="update ring because wall clean barely injury use kitchen leaf about bulb"
# Derivation path m/44'/60'/0'/0/0 (Ethereum default) → address
# 0xcD2E570Dc241E488c7BFf32FD377b4e3c93f775a. This is the SAME account the
# CLI signs with via Speculos; PRIVATE_KEY below is only used by the Foundry
# deploy/seed scripts to fund the AMM from that same address.

# Interpretation model, resolved through the pi harness as "<provider>:<model>".
# Omit for the default; any agent in pi's catalog works, e.g.
# "openai:gpt-5" or "google:gemini-3-flash-preview".
HUSKY_AGENT_MODEL=deepseek:deepseek-v4-flash

# Provider credential, read by the pi harness itself. Name it after whichever
# provider HUSKY_AGENT_MODEL selects (DEEPSEEK_API_KEY, OPENAI_API_KEY, ...).
DEEPSEEK_API_KEY=
# Derived from TESTNET_MNEMONIC above — same account, used only by
# packages/contracts' Foundry scripts (Deploy.s.sol / Seed.s.sol).
PRIVATE_KEY=0x03618da83f0df78d367ae9746274dc9c2483088dbc6f6e8a5438b9ef5ce7c4d9
