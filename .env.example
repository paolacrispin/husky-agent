# Copy to `.env`. This file holds ONLY the interpretation model configuration
# and its provider credential — everything chain-related (RPC, contract
# addresses, Speculos, Flashblocks) lives in `.env.testnet`, copied from
# `.env.testnet.example`. See docs/08-getting-started.md.
#
# `packages/agent` loads `.env`; `packages/agent/src/integration/config.ts`
# loads `.env.testnet` for the deterministic operation pipeline.

# Credential for whichever provider HUSKY_AGENT_MODEL selects. Pi reads this
# itself (DEEPSEEK_API_KEY, ANTHROPIC_API_KEY, ...). Never commit the real value.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# The model is resolved as <provider> + <model>. Either spelling works:
#   split   — HUSKY_AGENT_PROVIDER=deepseek / HUSKY_AGENT_MODEL=deepseek-v4-flash
#   combined — HUSKY_AGENT_MODEL=deepseek:deepseek-v4-flash
# An explicit HUSKY_AGENT_PROVIDER wins over a combined prefix.
HUSKY_AGENT_PROVIDER=deepseek
HUSKY_AGENT_MODEL=deepseek-v4-flash
